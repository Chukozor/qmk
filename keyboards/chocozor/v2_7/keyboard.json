{
  "keyboard_name": "Chukozor v2.7",
  "usb": {
      "pid": "0x0130",
      "device_version": "2.7.0"
  },
  "processor": "RP2040",
  "bootloader": "rp2040",
  "features": {
      "extrakey": true,
      "nkro": true,
      "oled": true
  },
  "encoder": {
      "enabled": true,
      "rotary": [{"pin_a": "GP23", "pin_b": "GP21"}]
  },
  "split": {
    "enabled": true,
    "transport": {
      "protocol": "serial",
      "driver": "usart",
      "pin_tx": "GP0",        // TX pin of the left half (left half → right half)
      "pin_rx": "GP1",        // RX pin of the left half (right half → left half)
      "half_duplex": false    // full duplex = false
    },
    "matrix_pins": {
      "rows": ["GP10", "GP2", "GP29", "GP28", "GP27", "GP26"],
      "cols": ["GP22", "GP14", "GP15", "GP16", "GP20", "GP9"]
    },
    "handedness": {
      "pin": "GP8"
    },
    "encoder": {
      "right": {
        "rotary": [
          { "pin_a": "GP21", "pin_b": "GP23" }
        ]
      }
    }
  },
  "diode_direction": "COL2ROW",
  "layouts": {
    "LAYOUT_split_2_7_full": {
